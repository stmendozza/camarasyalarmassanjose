---
import { site } from '../data/site';

interface Props {
	title: string;
	text: string;
	primaryLabel?: string;
	secondaryHref?: string;
	secondaryLabel?: string;
}

const {
	title,
	text,
	primaryLabel = site.phoneDisplay,
	secondaryHref = '/contacto',
	secondaryLabel = 'Ir a contacto',
} = Astro.props;
---

<section class="section cta-band">
	<div class="wrap">
		<h2>{title}</h2>
		<p>{text}</p>
		<div class="btn-row">
			<a class="btn btn-wa" href={site.whatsappUrl} target="_blank" rel="noopener noreferrer">
				{primaryLabel}
			</a>
			<a class="btn btn-ghost" href={secondaryHref}>{secondaryLabel}</a>
		</div>
	</div>
</section>

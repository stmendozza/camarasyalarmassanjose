---
import { site } from '../data/site';
import { footerNav } from '../data/navigation';
---

<footer class="site-footer">
	<div class="wrap">
		<p class="brand footer-brand">
			Cámaras y Alarmas<span class="dot">.</span>
			<small>San José</small>
		</p>
		<p>{site.brandName}. Instalación, configuración, reparación y mantenimiento a domicilio en {site.city} y zonas cercanas.</p>
		<nav aria-label="Pie de página">
			{
				footerNav.map((item) => (
					<a href={item.href}>{item.label}</a>
				))
			}
			<a href={site.whatsappUrl} target="_blank" rel="noopener noreferrer">WhatsApp</a>
			<a href={`tel:${site.phoneE164}`}>Llamar</a>
			<a href={`mailto:${site.email}`}>Correo</a>
		</nav>
	</div>
</footer>

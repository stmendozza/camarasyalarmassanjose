---
import { site } from '../data/site';
import { footerNav } from '../data/navigation';
---

<footer class="mt-auto bg-ink text-paper">
	<div class="mx-auto grid max-w-(--width-content) gap-8 px-4 py-12 sm:px-6 md:grid-cols-2">
		<div>
			<p class="font-display text-lg font-semibold uppercase tracking-tight">{site.brandName}</p>
			<p class="mt-2 text-sm text-paper/80">{site.tagline} · {site.city}</p>
			<p class="mt-4 text-sm">
				<a class="hover:text-gold-bright" href={`tel:${site.phoneE164}`}>{site.phoneDisplay}</a>
				{' · '}
				<a class="hover:text-gold-bright" href={`mailto:${site.email}`}>{site.email}</a>
			</p>
		</div>
		<nav class="flex flex-wrap gap-x-6 gap-y-2 text-sm" aria-label="Pie de página">
			{
				footerNav.map((item) => (
					<a href={item.href} class="text-paper/85 hover:text-gold-bright">
						{item.label}
					</a>
				))
			}
		</nav>
	</div>
	<p class="border-t border-white/10 py-4 text-center text-xs text-paper/60">
		© {new Date().getFullYear()} {site.brandName}
	</p>
</footer>

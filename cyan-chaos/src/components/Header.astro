---
import { site } from '../data/site';
import { mainNav } from '../data/navigation';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="sticky top-0 z-40 border-b border-navy/10 bg-white/95 backdrop-blur-sm">
	<div class="mx-auto flex h-16 max-w-(--width-content) items-center justify-between gap-4 px-4 sm:px-6">
		<a
			href="/"
			class="font-display text-xl font-semibold tracking-tight text-navy uppercase"
		>
			{site.brandName}
		</a>
		<nav class="hidden items-center gap-5 md:flex" aria-label="Principal">
			{
				mainNav.map((item) => {
					const href = item.href;
					const active = currentPath === href;
					return (
						<a
							href={href}
							class:list={[
								'text-sm font-semibold transition-colors',
								active ? 'text-gold' : 'text-slate hover:text-navy',
							]}
							aria-current={active ? 'page' : undefined}
						>
							{item.label}
						</a>
					);
				})
			}
		</nav>
		<a
			href={site.whatsappUrl}
			class="rounded-(--radius-brand) bg-wa px-3 py-2 text-sm font-semibold text-white hover:brightness-95"
			target="_blank"
			rel="noopener noreferrer"
		>
			WhatsApp
		</a>
	</div>
</header>

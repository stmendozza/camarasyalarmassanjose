---
import Wordmark from './Wordmark.astro';
import { site } from '../data/site';
import { footerNav, headerNav } from '../data/navigation';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const drawerNav = footerNav;
---

<header class="site-header">
	<div class="wrap bar">
		<Wordmark href="/" />
		<nav class="nav" aria-label="Principal">
			{
				headerNav.map((item) => (
					<a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>
						{item.label}
					</a>
				))
			}
		</nav>
		<button class="nav-toggle" type="button" aria-expanded="false" aria-controls="drawer" id="navBtn">
			Menú
		</button>
		<a class="btn btn-wa" href={site.whatsappUrl} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp">
			<span class="wa-label">WhatsApp</span>
			<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
				<path d="M3 8h8M8 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5"></path>
			</svg>
		</a>
	</div>
	<div class="nav-drawer" id="drawer" hidden>
		{
			drawerNav.map((item) => (
				<a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>
					{item.label}
				</a>
			))
		}
	</div>
</header>

<script>
	const btn = document.getElementById('navBtn');
	const drawer = document.getElementById('drawer');
	btn?.addEventListener('click', () => {
		if (!drawer || !btn) return;
		const open = drawer.classList.toggle('open');
		drawer.hidden = !open;
		btn.textContent = open ? 'Cerrar' : 'Menú';
		btn.setAttribute('aria-expanded', String(open));
	});
</script>

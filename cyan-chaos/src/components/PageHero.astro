---
import { site } from '../data/site';

interface Props {
	crumb: string;
	h1: string;
	lead: string;
	secondaryHref?: string;
	secondaryLabel?: string;
}

const {
	crumb,
	h1,
	lead,
	secondaryHref = '/contacto',
	secondaryLabel = 'Formulario',
} = Astro.props;
---

<header class="page-hero">
	<div class="page-hero-veil" aria-hidden="true"></div>
	<div class="wrap page-hero-inner">
		<p class="crumb"><a href="/">Inicio</a> <span aria-hidden="true">/</span> {crumb}</p>
		<h1>{h1}</h1>
		<p class="page-hero-lead">{lead}</p>
		<div class="btn-row">
			<a class="btn btn-gold" href={site.whatsappUrl} target="_blank" rel="noopener noreferrer">
				Cotizar por WhatsApp
				<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
					<path d="M3 8h8M8 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5"></path>
				</svg>
			</a>
			<a class="btn btn-glass" href={secondaryHref}>{secondaryLabel}</a>
		</div>
	</div>
</header>

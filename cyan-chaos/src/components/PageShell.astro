---
interface Props {
	h1: string;
	lead?: string;
}

const { h1, lead } = Astro.props;
---

<section class="border-b border-navy/10 bg-white">
	<div class="mx-auto max-w-(--width-content) px-4 py-12 sm:px-6 md:py-16">
		<h1 class="font-display text-3xl font-bold tracking-tight text-navy uppercase md:text-4xl">
			{h1}
		</h1>
		{lead && <p class="mt-4 max-w-2xl text-lg text-slate">{lead}</p>}
	</div>
</section>
<div class="mx-auto max-w-(--width-content) px-4 py-10 sm:px-6">
	<slot />
</div>

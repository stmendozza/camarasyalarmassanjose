---
import { Image } from 'astro:assets';
import logo from '../content/logo.png';

interface Props {
	href?: string;
}

const { href } = Astro.props;
---

{
	href ? (
		<a class="brand brand-logo" href={href} aria-label="Cámaras de Seguridad San José">
			<Image
				src={logo}
				alt=""
				class="brand-logo-img"
				widths={[280, 400, 520, 700]}
				sizes="(min-width: 720px) 288px, 248px"
				format="webp"
				quality={90}
				loading="eager"
				decoding="async"
			/>
		</a>
	) : (
		<p class="brand brand-logo">
			<Image
				src={logo}
				alt="Cámaras de Seguridad San José"
				class="brand-logo-img"
				widths={[280, 400, 520, 700]}
				sizes="(min-width: 720px) 352px, 280px"
				format="webp"
				quality={90}
				loading="lazy"
				decoding="async"
			/>
		</p>
	)
}

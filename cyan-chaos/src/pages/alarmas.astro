---
import PageLayout from '../layouts/PageLayout.astro';
import { getPageMeta } from '../data/pages-meta';
import { getEntry } from 'astro:content';

const meta = getPageMeta('alarmas');
const service = await getEntry('services', 'alarmas');
---

<PageLayout
	title={meta.title}
	description={meta.description}
	h1={meta.h1}
	lead={service?.data.summary}
	pathname="/alarmas"
>
	<p class="text-slate">Contenido de alarmas y sensores — Fase 5.</p>
</PageLayout>

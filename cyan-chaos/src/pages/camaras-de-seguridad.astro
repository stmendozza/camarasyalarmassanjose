---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ProductCard from '../components/ProductCard.astro';
import FaqList from '../components/FaqList.astro';
import CtaBand from '../components/CtaBand.astro';
import { getPageMeta } from '../data/pages-meta';
import { productTypeDetail, productTypeLabel } from '../data/product-labels';
import { getCollection } from 'astro:content';

const meta = getPageMeta('camaras-de-seguridad');
const cameraTypes = ['bala', 'domo', 'ptz', 'wifi'] as const;
const products = (await getCollection('products'))
	.filter((entry) => cameraTypes.includes(entry.data.type as (typeof cameraTypes)[number]))
	.sort((a, b) => a.data.order - b.data.order);
const faqs = (await getCollection('faqs')).filter((entry) =>
	entry.data.pageSlugs.includes('camaras-de-seguridad'),
);
---

<BaseLayout title={meta.title} description={meta.description} pathname="/camaras-de-seguridad">
	<PageHero crumb="Cámaras" h1={meta.h1} lead="Instalación profesional, monitoreo en vivo con app y soporte técnico local para hogar y negocio." />

	<section class="section section-band">
		<div class="wrap">
			<div class="section-head">
				<p class="kicker">Equipos</p>
				<h2>Soluciones y tipos de cámara</h2>
				<p>
					Te asesoramos para elegir la tecnología ideal: cámaras bala, domo, robóticas PTZ, sistemas IP,
					Wi-Fi o con paneles solares.
				</p>
			</div>
			<div class="product-grid">
				{
					products.map((product) => (
						<ProductCard
							name={product.data.name}
							typeLabel={
								productTypeDetail[product.data.type as keyof typeof productTypeDetail] ??
								productTypeLabel[product.data.type]
							}
							visual={productTypeLabel[product.data.type]}
							specs={product.data.specs}
						/>
					))
				}
			</div>
		</div>
	</section>

	<section class="section" style="padding-top: 0">
		<div class="wrap">
			<div class="section-head">
				<p class="kicker">Públicos</p>
				<h2>Hogar, negocio o finca</h2>
				<p>Misma calidad de equipos; recomendación técnica personalizada según el espacio.</p>
			</div>
			<div class="package-grid">
				<div class="panel" id="hogar">
					<h3>Para el hogar</h3>
					<p>
						Entradas, patios, garajes y áreas comunes. Monitoreo en vivo desde la app y grabación
						continua para la tranquilidad de tu familia.
					</p>
				</div>
				<div class="panel" id="negocios">
					<h3>Para el negocio</h3>
					<p>
						Caja, inventario, vitrinas y accesos. Cobertura nocturna de alta definición para
						supervisar la operación y proteger tus activos.
					</p>
				</div>
				<div class="panel" id="finca">
					<h3>Para la finca</h3>
					<p>
						Linderos, casetas, potreros y portones. Soluciones autónomas con paneles solares y
						conexión 4G para zonas sin energía ni internet fijo.
					</p>
				</div>
			</div>
			<p class="page-links">
				<a href="/hogar">Ver soluciones para el hogar</a>
				<a href="/negocios">Ver soluciones para negocios</a>
				<a href="/instalacion">Cómo instalamos</a>
			</p>
		</div>
	</section>

	<section class="section" style="padding-top: 0">
		<div class="wrap">
			<div class="section-head">
				<p class="kicker">App</p>
				<h2>Monitoreo desde el celular</h2>
				<p>App incluida — vigila en vivo cuando lo necesites.</p>
			</div>
			<div class="panel">
				<h3>Cómo funciona</h3>
				<p>
					Tras la instalación te dejamos el sistema configurado y te explicamos el uso de la app. Si algo
					falla, el soporte es local en San José del Guaviare.
				</p>
			</div>
		</div>
	</section>

	<FaqList entries={faqs} />
	<CtaBand
		title="Cotiza tus cámaras"
		text="Cuéntanos si es hogar o negocio y te respondemos por WhatsApp."
		primaryLabel="Escribir ahora"
		secondaryHref="/"
		secondaryLabel="Volver al inicio"
	/>
</BaseLayout>

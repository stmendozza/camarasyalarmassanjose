---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { getPageMeta } from '../data/pages-meta';
import { site } from '../data/site';
import { getCollection } from 'astro:content';

const meta = getPageMeta('cobertura');
const zones = (await getCollection('zones')).sort((a, b) => a.data.priority - b.data.priority);
---

<BaseLayout title={meta.title} description={meta.description} pathname="/cobertura">
	<PageHero
		crumb="Cobertura"
		h1={meta.h1}
		lead={`Instalación, envíos y soporte con base en ${site.city}. Las zonas vecinas se confirman al cotizar.`}
		secondaryLabel="Contacto"
	/>

	<section class="section">
		<div class="wrap">
			<div class="section-head">
				<p class="kicker">Zonas</p>
				<h2>Dónde llegamos hoy</h2>
				<p>
					La base del servicio es {site.city}. Si estás en un municipio cercano, al cotizar te decimos si
					podemos ir.
				</p>
			</div>
			<ul class="steps">
				{
					zones.map((zone) => (
						<li>
							<strong>{zone.data.name}</strong>
							<p>
								{zone.data.description}
								{!zone.data.confirmed && ' Escríbenos para saber si llegamos.'}
							</p>
						</li>
					))
				}
			</ul>
			<p style="margin-top: 1.5rem">
				<a href="/instalacion">Instalación</a>
				{' · '}
				<a href="/contacto">Contacto</a>
			</p>
		</div>
	</section>

	<CtaBand title="¿Tu zona está cubierta?" text="Escríbenos el barrio o el municipio y te decimos si podemos ir." />
</BaseLayout>

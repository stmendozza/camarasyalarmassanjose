---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { getPageMeta } from '../data/pages-meta';
import { site } from '../data/site';
import { getCollection } from 'astro:content';

const meta = getPageMeta('cobertura');
const zones = (await getCollection('zones')).sort((a, b) => a.data.priority - b.data.priority);
---

<BaseLayout title={meta.title} description={meta.description} pathname="/cobertura">
	<PageHero
		crumb="Cobertura"
		h1={meta.h1}
		lead={`La base es ${site.city}, capital del Guaviare. También trabajamos en El Retorno, Calamar, Mapiripán y Concordia.`}
		secondaryLabel="Contacto"
	/>

	<section class="section">
		<div class="wrap">
			<div class="section-head">
				<p class="kicker">Zonas</p>
				<h2>Dónde llegamos hoy</h2>
				<p>
					Estas son las zonas donde instalamos y damos soporte. San José del Guaviare es la principal.
				</p>
			</div>
			<ul class="steps">
				{
					zones.map((zone) => (
						<li id={zone.id}>
							<strong>{zone.data.name}</strong>
							<p>
								{zone.data.description}
							</p>
						</li>
					))
				}
			</ul>
			<p style="margin-top: 1.5rem">
				<a href="/instalacion">Instalación</a>
				{' · '}
				<a href="/contacto">Contacto</a>
			</p>
		</div>
	</section>

	<CtaBand
		title="Agenda en tu municipio"
		text="Escríbenos desde San José del Guaviare, El Retorno, Calamar, Mapiripán o Concordia."
	/>
</BaseLayout>

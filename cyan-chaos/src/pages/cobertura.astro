---
import BaseLayout from '../layouts/BaseLayout.astro';
import CoverageMap from '../components/CoverageMap.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { getPageMeta } from '../data/pages-meta';
import { site } from '../data/site';
import { getCollection } from 'astro:content';

const meta = getPageMeta('cobertura');
const zones = (await getCollection('zones')).sort((a, b) => a.data.priority - b.data.priority);
---

<BaseLayout title={meta.title} description={meta.description} pathname="/cobertura">
	<PageHero
		crumb="Cobertura"
		h1={meta.h1}
		lead={`La base es ${site.city}, capital del Guaviare. También trabajamos en El Retorno, Calamar, Mapiripán y Concordia.`}
		secondaryLabel="Contacto"
	/>

	<section class="section section-band">
		<div class="wrap lp-coverage">
			<div class="lp-coverage-copy">
				<div class="section-head">
					<p class="kicker">Zonas</p>
					<h2>Cobertura y atención regional</h2>
					<p>
						Instalación profesional y soporte técnico directo en San José del Guaviare y municipios
						aledaños. Cobertura garantizada para cascos urbanos, veredas y zonas rurales.
					</p>
				</div>
				<ul class="lp-zones">
					{
						site.serviceAreas.map((area) => (
							<li>
								<button type="button" data-cov-focus={area.slug}>
									{area.primary ? `${area.name} (Sede principal)` : area.name}
								</button>
							</li>
						))
					}
				</ul>
			</div>
			<CoverageMap id="coverage-map-page" />
		</div>
	</section>

	<section class="section">
		<div class="wrap">
			<ul class="steps">
				{
					zones.map((zone) => (
						<li id={zone.id}>
							<strong>{zone.data.name}</strong>
							<p>{zone.data.description}</p>
						</li>
					))
				}
			</ul>
			<p class="page-links">
				<a href="/instalacion">Instalación</a>
				<a href="/contacto">Contacto</a>
			</p>
		</div>
	</section>

	<CtaBand
		title="Agenda en tu municipio"
		text="Escríbenos desde San José del Guaviare, El Retorno, Calamar, Mapiripán o Concordia."
	/>
</BaseLayout>

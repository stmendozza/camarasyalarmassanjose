---
import PageLayout from '../layouts/PageLayout.astro';
import { getPageMeta } from '../data/pages-meta';
import { site } from '../data/site';

const meta = getPageMeta('contacto');
---

<PageLayout title={meta.title} description={meta.description} h1={meta.h1} pathname="/contacto">
	<p class="text-slate">
		Formulario externo (Formspree/Web3Forms) — Fase 5. Mientras tanto, usa WhatsApp:
	</p>
	<p class="mt-4">
		<a
			href={site.whatsappUrl}
			class="font-semibold text-navy-mid underline hover:text-gold"
			target="_blank"
			rel="noopener noreferrer"
		>
			{site.phoneDisplay}
		</a>
	</p>
</PageLayout>

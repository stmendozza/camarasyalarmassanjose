---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageShell from '../components/PageShell.astro';
import { getPageMeta } from '../data/pages-meta';
import { site } from '../data/site';
import { getCollection } from 'astro:content';

const meta = getPageMeta('home');
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title={meta.title} description={meta.description} pathname="/">
	<section class="bg-ink text-white">
		<div class="mx-auto max-w-(--width-content) px-4 py-16 sm:px-6 md:py-24">
			<p class="font-display text-sm font-semibold tracking-widest text-gold uppercase">
				{site.city}
			</p>
			<h1 class="mt-3 max-w-3xl font-display text-4xl font-bold tracking-tight uppercase md:text-5xl">
				{meta.h1}
			</h1>
			<p class="mt-4 max-w-xl text-lg text-paper/90">
				Cámaras, alarmas inteligentes e instalación profesional. Cotiza por WhatsApp.
			</p>
			<div class="mt-8 flex flex-wrap gap-3">
				<a
					href={site.whatsappUrl}
					class="rounded-(--radius-brand) bg-wa px-5 py-3 font-semibold text-white hover:brightness-95"
					target="_blank"
					rel="noopener noreferrer"
				>
					Cotizar por WhatsApp
				</a>
				<a
					href="/contacto"
					class="rounded-(--radius-brand) border border-gold/60 px-5 py-3 font-semibold text-gold-bright hover:bg-white/5"
				>
					Contacto
				</a>
			</div>
		</div>
	</section>

	<section class="border-b border-gold/30 bg-navy text-white" aria-labelledby="audiencia">
		<div class="mx-auto grid max-w-(--width-content) md:grid-cols-2">
			<a
				id="audiencia"
				href="/hogar"
				class="group border-b border-white/10 p-8 transition-colors hover:bg-navy-mid md:border-r md:border-b-0"
			>
				<h2 class="font-display text-2xl font-bold uppercase">Hogar</h2>
				<p class="mt-2 text-paper/85">Seguridad familiar con soporte local.</p>
				<span class="mt-4 inline-block text-gold-bright group-hover:underline">Ver soluciones →</span>
			</a>
			<a href="/negocios" class="group p-8 transition-colors hover:bg-navy-mid">
				<h2 class="font-display text-2xl font-bold uppercase">Negocio</h2>
				<p class="mt-2 text-paper/85">Vigilancia para inventario y accesos.</p>
				<span class="mt-4 inline-block text-gold-bright group-hover:underline">Ver soluciones →</span>
			</a>
		</div>
	</section>

	<PageShell h1="Servicios" lead="Scaffolding Fase 4 — maquetado completo en Fase 5.">
		<ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
			{
				services.map((entry) => (
					<li class="rounded-(--radius-brand) border border-navy/10 bg-white p-5 shadow-sm">
						<h3 class="font-display text-lg font-semibold text-navy uppercase">{entry.data.title}</h3>
						<p class="mt-2 text-sm text-slate">{entry.data.summary}</p>
						<a
							href={`/${entry.id}`}
							class="mt-4 inline-block text-sm font-semibold text-navy-mid hover:text-gold"
						>
							Ver más
						</a>
					</li>
				))
			}
		</ul>
	</PageShell>
</BaseLayout>

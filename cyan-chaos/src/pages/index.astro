---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import heroImage from '../content/image-hero.png';
import { getPageMeta } from '../data/pages-meta';
import { site } from '../data/site';

const meta = getPageMeta('home');
---

<BaseLayout title={meta.title} description={meta.description} pathname="/">
	<section class="hero" id="inicio">
		<div class="wrap">
			<div>
				<p class="pill"><i></i> Atención a domicilio</p>
				<h1>Seguridad bien instalada, lista cuando la necesitas.</h1>
				<p class="lede">
					Instalación, configuración, reparación y mantenimiento de cámaras y alarmas a domicilio para
					hogares y negocios. La base es {site.city}, capital del Guaviare.
				</p>
				<ul class="places">
					{
						site.serviceAreas.map((area) => (
							<li>
								{area.primary ? <strong>{area.name}</strong> : area.name}
							</li>
						))
					}
				</ul>
				<div class="btn-row">
					<a class="btn btn-ghost" href="/contacto">Cuéntanos qué necesitas</a>
					<a class="btn btn-wa" href={site.whatsappUrl} target="_blank" rel="noopener noreferrer">
						Consultar por WhatsApp
					</a>
				</div>
			</div>
			<Image
				src={heroImage}
				alt="Cámara domo, cámara bala y celular con vista en vivo, sobre el paisaje del Guaviare."
				class="hero-photo"
				widths={[480, 720, 960, 1280]}
				sizes="(min-width: 960px) 36rem, calc(100vw - 2.5rem)"
				quality={68}
				loading="eager"
				fetchpriority="high"
				decoding="async"
			/>
		</div>
	</section>

	<section class="section" id="servicios">
		<div class="wrap">
			<div class="section-head">
				<p class="kicker">Un sistema que sí te sirve</p>
				<h2>Desde la primera cámara hasta el próximo ajuste.</h2>
				<p>
					No todas las instalaciones necesitan lo mismo. Revisamos el espacio, escuchamos lo que buscas y
					proponemos una solución acorde al uso.
				</p>
			</div>
			<div class="note">
				<strong>Atención cercana</strong>
				<p>
					Hogares, tiendas, restaurantes, talleres y oficinas en {site.city}.
					<a href="/hogar">Hogar</a>
					{' · '}
					<a href="/negocios">Negocios</a>
				</p>
			</div>
			<ol class="rows">
				<li>
					<a href="/instalacion">
						<span class="num">01</span>
						<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
							<path d="M4 18h16M8 18V8l4-3 4 3v10" fill="none" stroke="currentColor" stroke-width="1.5"></path>
						</svg>
						<div>
							<h3>Instalación</h3>
							<p>Montaje de cámaras y alarmas según el espacio del hogar o del negocio.</p>
						</div>
					</a>
				</li>
				<li>
					<a href="/camaras-de-seguridad">
						<span class="num">02</span>
						<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
							<rect x="3" y="6" width="13" height="10" rx="2" fill="none" stroke="currentColor" stroke-width="1.5"></rect>
							<path d="M16 10l5-2v8l-5-2z" fill="none" stroke="currentColor" stroke-width="1.5"></path>
						</svg>
						<div>
							<h3>Configuración</h3>
							<p>Ajuste de DVR y NVR, y orientación para ver el sistema desde el celular.</p>
						</div>
					</a>
				</li>
				<li>
					<a href="/mantenimiento">
						<span class="num">03</span>
						<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
							<path d="M14 6l4 4-8 8H6v-4z" fill="none" stroke="currentColor" stroke-width="1.5"></path>
						</svg>
						<div>
							<h3>Reparación</h3>
							<p>Diagnóstico de cámaras, grabadores y alarmas que ya tienes.</p>
						</div>
					</a>
				</li>
				<li>
					<a href="/mantenimiento">
						<span class="num">04</span>
						<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
							<circle cx="12" cy="12" r="7" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
							<path d="M12 9v4l2 2" fill="none" stroke="currentColor" stroke-width="1.5"></path>
						</svg>
						<div>
							<h3>Mantenimiento</h3>
							<p>Revisión de imagen, conexiones, almacenamiento y grabación.</p>
						</div>
					</a>
				</li>
			</ol>
		</div>
	</section>

	<section class="section" id="mantenimiento">
		<div class="wrap maint">
			<div class="lime-panel">
				<p class="every">Cada</p>
				<p class="big">03<span>.</span></p>
				<p>meses, una revisión con propósito.</p>
				<p>El alcance se define para cada instalación.</p>
			</div>
			<div>
				<div class="section-head">
					<p class="kicker">Cuidado preventivo</p>
					<h2>Que la grabación y el acceso sigan respondiendo.</h2>
					<p>
						Una visita puede incluir limpieza, revisión de imagen y conexiones, pruebas de grabación y
						verificación del acceso desde el celular.
					</p>
				</div>
				<ul class="checks">
					<li>Imagen, limpieza y visión nocturna</li>
					<li>Conectores, fuentes y cableado visible</li>
					<li>DVR, NVR, disco y estado de grabación</li>
					<li>Fecha, hora y acceso desde el celular</li>
				</ul>
				<p style="margin-top: 1.25rem">
					<a class="btn btn-ghost" href="/mantenimiento">Consultar por mantenimiento</a>
				</p>
			</div>
		</div>
	</section>

	<section class="section" style="padding-top: 0">
		<div class="wrap">
			<div class="section-head">
				<p class="kicker">La confianza también se configura</p>
				<h2>Instalar bien es el comienzo. Acompañarte es parte del trabajo.</h2>
				<p>
					Te explicamos cómo consultar el sistema, qué revisar si aparece una falla y cuándo conviene
					reparar, ampliar o actualizar.
				</p>
				<p>
					También te orientamos para cuidar el acceso y manejar las grabaciones con responsabilidad.
				</p>
			</div>
			<a href="/sobre-nosotros">Sobre el soporte local</a>
		</div>
	</section>

	<section class="section cta-band" id="contacto">
		<div class="wrap">
			<p class="kicker">Siguiente paso</p>
			<h2>Cuéntanos qué quieres cuidar.</h2>
			<p>Una instalación nueva, una falla o una revisión: conversemos y revisamos qué necesita tu espacio.</p>
			<div class="btn-row">
				<a class="btn btn-wa" href={site.whatsappUrl} target="_blank" rel="noopener noreferrer">
					Escribir por WhatsApp
				</a>
				<a class="btn btn-ghost" href={`mailto:${site.email}`}>Enviar un correo</a>
			</div>
			<p class="meta">
				{site.serviceAreas.map((area) => area.name).join(' · ')}.<br />
				<a href={site.whatsappUrl}>{site.phoneDisplay}</a>
				{' · '}
				<a href={`mailto:${site.email}`}>{site.email}</a>
			</p>
		</div>
	</section>
</BaseLayout>

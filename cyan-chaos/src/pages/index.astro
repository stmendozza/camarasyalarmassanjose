---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import heroBg from '../content/hero.png';
import CoverageMap from '../components/CoverageMap.astro';
import Icon from '../components/Icon.astro';
import SystemExplorer from '../components/SystemExplorer.astro';
import { landingAudiences } from '../data/navigation';
import { getPageMeta } from '../data/pages-meta';
import { site } from '../data/site';

const meta = getPageMeta('home');
const waMessage = encodeURIComponent(
	`Hola, quiero cotizar un sistema de seguridad con ${site.brandName} en ${site.city}.`,
);
const waPrimary = `${site.whatsappUrl}?text=${waMessage}`;

const stripItems = [
	{ icon: 'phone' as const, title: 'App en tiempo real', text: 'Supervisión continua sin costos extras.' },
	{ icon: 'install' as const, title: 'Servicio completo', text: 'Montaje, cableado e inducción incluidos.' },
	{ icon: 'support' as const, title: 'Atención directa', text: 'Técnicos locales a tu disposición.' },
];

const processSteps = [
	{
		icon: 'chat' as const,
		title: 'Consulta inicial',
		text: 'Nos escribes por WhatsApp y nos explicas las zonas que quieres monitorear.',
	},
	{
		icon: 'plan' as const,
		title: 'Diseño de la solución',
		text: 'Te sugerimos el kit exacto de cámaras o alarmas que realmente necesitas.',
	},
	{
		icon: 'ready' as const,
		title: 'Montaje y entrega',
		text: 'Instalamos los equipos, configuramos la app en tu celular y te dejamos todo probado.',
	},
];
---

<BaseLayout title={meta.title} description={meta.description} pathname="/">
	{/* Landing de conversión: promesa → sistemas → público → proceso → cobertura → CTA */}
	<section class="lp-hero" id="inicio" aria-label="Inicio">
		<div class="lp-hero-bg" aria-hidden="true">
			<Image
				src={heroBg}
				alt=""
				class="lp-hero-img"
				widths={[720, 1080, 1440, 1852]}
				sizes="100vw"
				quality={72}
				format="webp"
				loading="eager"
				fetchpriority="high"
				decoding="async"
			/>
		</div>
		<div class="lp-hero-veil" aria-hidden="true"></div>

		<div class="wrap lp-hero-frame">
			<div class="lp-hero-copy">
				<p class="lp-brand">{site.brandName}</p>
				<h1>
					Seguridad inteligente y monitoreo 24/7
					<span class="lp-hero-break">sin importar dónde estés</span>
				</h1>
				<p class="lp-hero-lead">
					Protege tu hogar, negocio o finca con sistemas de videovigilancia de alta definición,
					monitoreo en vivo desde tu celular y respaldo técnico directo en {site.city} y alrededores.
				</p>
				<div class="lp-hero-actions">
					<a class="btn btn-gold btn-lg lp-hero-cta" href={waPrimary} target="_blank" rel="noopener noreferrer">
						Cotizar por WhatsApp
						<svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
							<path d="M3 8h8M8 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5"></path>
						</svg>
					</a>
					<a class="btn btn-glass btn-lg lp-hero-secondary" href="/contacto">Solicitar asesoría</a>
				</div>
				<p class="lp-hero-meta">
					<a href={waPrimary} target="_blank" rel="noopener noreferrer">{site.phoneDisplay}</a>
					<span aria-hidden="true">·</span>
					Respuesta por WhatsApp
				</p>
			</div>
		</div>
	</section>

	<section class="lp-strip" aria-label="Pilares">
		<div class="wrap">
			<ul class="lp-strip-grid">
				{
					stripItems.map((item) => (
						<li>
							<span class="lp-strip-ico">
								<Icon name={item.icon} size={20} />
							</span>
							<span class="lp-strip-copy">
								<strong>{item.title}</strong>
								{item.text}
							</span>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<section class="lp-section" id="sistemas">
		<div class="wrap">
			<header class="lp-head">
				<h2>Soluciones de seguridad a la medida</h2>
				<p>
					Contamos con la tecnología adecuada para tu hogar, comercio o finca. Selecciona el servicio
					de tu interés y cotiza en minutos sin compromiso.
				</p>
			</header>
			<SystemExplorer />
		</div>
	</section>

	<section class="lp-section lp-section-alt" id="publicos">
		<div class="wrap">
			<header class="lp-head">
				<p class="kicker">Públicos</p>
				<h2>Soluciones para hogar, negocio y fincas</h2>
				<p>
					Sistemas de seguridad diseñados y parametrizados según las dimensiones y la infraestructura
					de cada lugar.
				</p>
			</header>
			<div class="lp-audience">
				{
					landingAudiences.map((item) => (
						<a class="lp-audience-card" href={item.href}>
							<span class="lp-audience-ico">
								<Icon name={item.icon} size={24} />
							</span>
							<h3>{item.title}</h3>
							<p>{item.lead}</p>
							<span class="lp-audience-go">
								Explorar
								<Icon name="arrow" size={14} />
							</span>
						</a>
					))
				}
			</div>
		</div>
	</section>

	<section class="lp-section lp-aurora" id="proceso" aria-label="Proceso">
		<div class="lp-aurora-field" aria-hidden="true">
			<span class="lp-aurora-blob lp-aurora-blob-a"></span>
			<span class="lp-aurora-blob lp-aurora-blob-b"></span>
			<span class="lp-aurora-blob lp-aurora-blob-c"></span>
			<span class="lp-aurora-veil"></span>
		</div>
		<div class="wrap">
			<header class="lp-head">
				<h2>¿Cómo trabajamos?</h2>
				<p>Un proceso ágil, sin complicaciones ni demoras.</p>
			</header>
			<ol class="lp-process">
				{
					processSteps.map((step) => (
						<li>
							<span class="lp-process-ico">
								<Icon name={step.icon} size={22} />
							</span>
							<strong>{step.title}</strong>
							<p>{step.text}</p>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<section class="lp-section lp-section-alt" id="cobertura">
		<div class="wrap lp-coverage">
			<div class="lp-coverage-copy">
				<header class="lp-head">
					<h2>Cobertura y atención regional</h2>
					<p>
						Instalación profesional y soporte técnico directo en {site.city} y municipios aledaños.
						Cobertura garantizada para cascos urbanos, veredas y zonas rurales.
					</p>
				</header>
				<ul class="lp-zones">
					{
						site.serviceAreas.map((area) => (
							<li>
								<button type="button" data-cov-focus={area.slug}>
									<Icon name="pin" size={14} />
									{area.primary ? `${area.name} (Sede principal)` : area.name}
								</button>
							</li>
						))
					}
				</ul>
				<a class="btn btn-glass" href="/cobertura">
					Detalle por zona
					<Icon name="arrow" size={14} />
				</a>
			</div>
			<CoverageMap />
		</div>
	</section>

	<section class="lp-final" id="contacto">
		<div class="wrap lp-final-inner">
			<h2>Listo para proteger tu espacio</h2>
			<p>
				Una instalación nueva, una falla o una revisión: escríbenos y te respondemos desde {site.city}.
			</p>
			<div class="btn-row">
				<a class="btn btn-gold btn-lg" href={waPrimary} target="_blank" rel="noopener noreferrer">
					<Icon name="whatsapp" size={18} />
					Escribir por WhatsApp
					<Icon name="arrow" size={15} />
				</a>
				<a class="btn btn-glass btn-lg" href="/contacto">Dejar datos</a>
			</div>
			<p class="lp-final-meta">
				<a href={site.whatsappUrl}>
					<Icon name="phone" size={15} />
					{site.phoneDisplay}
				</a>
				<span aria-hidden="true">·</span>
				<a href={`mailto:${site.email}`}>
					<Icon name="mail" size={15} />
					{site.email}
				</a>
			</p>
		</div>
	</section>
</BaseLayout>

---
import PageLayout from '../layouts/PageLayout.astro';
import { getPageMeta } from '../data/pages-meta';
import { getEntry } from 'astro:content';

const meta = getPageMeta('mantenimiento');
const service = await getEntry('services', 'mantenimiento');
---

<PageLayout
	title={meta.title}
	description={meta.description}
	h1={meta.h1}
	lead={service?.data.summary}
	pathname="/mantenimiento"
>
	<p class="text-slate">Planes de mantenimiento — Fase 5.</p>
</PageLayout>

---
import PageLayout from '../layouts/PageLayout.astro';
import { getPageMeta } from '../data/pages-meta';
import { getEntry } from 'astro:content';

const meta = getPageMeta('sistemas-de-seguridad');
const service = await getEntry('services', 'sistemas-de-seguridad');
---

<PageLayout
	title={meta.title}
	description={meta.description}
	h1={meta.h1}
	lead={service?.data.summary}
	pathname="/sistemas-de-seguridad"
>
	<p class="text-slate">Comparativa de paquetes — Fase 5.</p>
</PageLayout>
